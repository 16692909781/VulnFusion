# Optional DeepSeek planner configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Kali is the only execution environment for network/security scanners.
# Leave VULNFUSION_KALI_HOST empty to keep all runtime tasks in preview mode.
VULNFUSION_KALI_HOST=
VULNFUSION_KALI_USER=kali
VULNFUSION_KALI_PORT=22
VULNFUSION_KALI_KEY=
VULNFUSION_KALI_REMOTE_ROOT=/home/kali/vulnfusion/workspaces
VULNFUSION_KALI_TIMEOUT=15
# Kali's ProjectDiscovery binary; do not use the Python HTTPX CLI.
VULNFUSION_KALI_HTTPX=httpx-toolkit
